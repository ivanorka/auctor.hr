<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to web.config on the IIS server and replace every placeholder there.
     Do not commit the production web.config. Prefer IIS/app-pool environment
     variables when the hosting provider supports them. -->
<configuration>
  <appSettings>
    <add key="CONTACT_TO" value="CONTACT_INBOX_ON_SERVER" />
    <add key="CONTACT_FROM" value="VERIFIED_ROLE_ADDRESS_ON_AUCTOR_DOMAIN" />
    <add key="SMTP_HOST" value="127.0.0.1" />
    <add key="SMTP_PORT" value="25" />
    <add key="SMTP_SSL" value="false" />
    <add key="SMTP_USERNAME" value="" />
    <add key="SMTP_PASSWORD" value="" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.0" />
    <httpRuntime targetFramework="4.0" maxRequestLength="64" executionTimeout="15" />
    <customErrors mode="RemoteOnly" />
  </system.web>
  <system.webServer>
    <!-- Requires the IIS URL Rewrite module. Install a trusted TLS certificate
         before publishing this production-only canonical redirect. -->
    <rewrite>
      <rules>
        <rule name="Remove index.html" stopProcessing="true">
          <match url="^(.*\/)?index\.html$" ignoreCase="true" />
          <action type="Redirect" url="https://www.auctor.hr/{R:1}" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <rule name="Canonical HTTPS and www host" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^www\.auctor\.hr(?::\d+)?$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://www.auctor.hr/{R:1}" appendQueryString="true" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="Auto">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
      </customHeaders>
    </httpProtocol>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="65536" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
